# ============ Build Stage ============
FROM golang:1.25.7-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -o server .

# ============ Runtime Stage ============
FROM alpine:3.22

RUN apk --no-cache add ca-certificates tzdata
ENV TZ=Asia/Tokyo

WORKDIR /app

COPY --from=builder /app/server .

EXPOSE 8080

CMD ["./server"]
